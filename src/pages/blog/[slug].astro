---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Icon from "../../components/Icon.svelte";
import { getCollection, render } from "astro:content";
import { slugifyTag } from "../../utils/tags";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Slug sem extensão
const slug = post.id.replace(/\.[^/]+$/, '');

// Find related posts by tag overlap
const allPosts = (await getCollection("blog"))
  .filter((p) => p.id !== post.id && !p.data.draft);

const postTags = post.data.tags || [];

const related = allPosts
  .map((p) => ({
    post: p,
    score: (p.data.tags || []).filter((t) => postTags.includes(t)).length,
  }))
  .filter((p) => p.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);

const updated = post.data.updated || post.data.pubDate;
---

<BaseLayout
  title={post.data.seoTitle || post.data.title}
  description={post.data.seoDescription || post.data.description}
  slug={slug}
  pubDate={post.data.pubDate}
  updated={post.data.updated}
  tags={post.data.tags}
  ogImage={post.data.ogImage || undefined}
  isBlogPost={true}
  noindex={post.data.noindex}
>
  <Navbar slot="header" />

  <div class="pt-8 pb-16">
    <a
      href="/blog"
      data-astro-prefetch
      class="inline-flex items-center gap-2 py-1 text-xs font-bold uppercase tracking-wider text-ink-2 hover:text-ink-2 transition-colors"
    >
      <Icon name="arrow-left" class="inline" size={10} /> Voltar ao Journal
    </a>
    <article class="section">
      <div class="mb-8">
        <span class="font-mono text-[10px] text-ink-2 uppercase tracking-widest block mb-2">
          <time datetime={post.data.pubDate.toISOString()}>
            {
              post.data.pubDate.toLocaleDateString("pt-BR", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
          {post.data.updated && (
            <span class="text-ink-2"> · <time datetime={updated.toISOString()}>atualizado em {
              updated.toLocaleDateString("pt-BR", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }</time></span>
          )}
        </span>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {post.data.tags.map((tag) => (
              <a
                href={`/blog/tag/${slugifyTag(tag)}`}
                data-astro-prefetch
                class="font-mono text-[10px] px-2 py-0.5 border border-rule bg-paper-3 text-ink-2 hover:bg-rule hover:text-ink uppercase tracking-wider transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        )}
        <h1 class="text-3xl sm:text-4xl font-display text-ink leading-tight mb-4">
          {post.data.title}
        </h1>
        <p class="text-ink-2 text-sm italic font-light">
          {post.data.description}
        </p>
      </div>

      <!-- Article Content -->
      <div class="prose max-w-none text-ink-2 text-sm leading-relaxed space-y-5
        prose-headings:font-display prose-headings:text-ink
        prose-h2:text-xl prose-h2:border-b prose-h2:border-rule prose-h2:pb-2 prose-h2:mt-8
        prose-p:leading-relaxed
        prose-a:underline prose-a:underline-offset-2
        prose-pre:bg-paper-3 prose-pre:border prose-pre:border-rule prose-pre:p-4 prose-pre:rounded-none prose-pre:font-mono prose-pre:text-sm
        prose-strong:text-ink prose-strong:font-medium
        prose-li:text-ink-2">
        <Content />
      </div>

    </article>

    <!-- Related Posts -->
    {related.length > 0 && (
      <section class="section">
        <h2 class="text-xl font-display text-ink">Posts Relacionados</h2>
        <div class="space-y-5">
          {related.map(({ post: p }) => (
            <a href={`/blog/${p.id}`} data-astro-prefetch class="block group border-t border-rule pt-5">
              <div class="flex items-center gap-2 mb-2">
                  <span class="font-mono text-[10px] text-ink-2 uppercase tracking-widest">
                    {p.data.pubDate.toLocaleDateString("pt-BR", { year: "numeric", month: "short" })}
                  </span>
                  {p.data.tags && p.data.tags.length > 0 && (
                    <>
                      <span class="text-ink-2">·</span>
                      {p.data.tags.slice(0, 2).map((t) => (
                        <span class="font-mono text-[10px] px-2 py-0.5 border border-rule bg-paper-3 text-ink-2 uppercase tracking-wider">
                          {t}
                        </span>
                      ))}
                    </>
                  )}
                </div>
                <h3 class="text-base font-display text-ink group-hover:text-accent transition-colors">
                  {p.data.title}
                </h3>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
