---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import PaperCard from "../../components/PaperCard.astro";
import TagFilter from "../../components/TagFilter.astro";
import BlogIntro from "../../components/BlogIntro.astro";
import SearchBar from "../../components/SearchBar.astro";
import Icon from "../../components/Icon.svelte";
import { getCollection } from "astro:content";
import { slugifyTag } from "../../utils/tags";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<BaseLayout
  title="Journal de Pesquisa | Fabrício Scaglioni"
  description="Artigos e notas de Fabrício Scaglioni sobre inteligência artificial, aprendizado de máquina, engenharia de software e educação."
>
  <Navbar slot="header" />

  <article class="pt-8 pb-16">
    <PaperCard class="p-6 sm:p-8 mb-6 relative overflow-hidden">
      <div class="flex items-center gap-4 relative">
        <div class="w-12 h-12 rounded-lg border border-gray-200 bg-gray-100 flex items-center justify-center flex-shrink-0">
          <Icon name="feather" class="text-gray-600 inline" size={20} />
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl font-display italic tracking-wide text-gray-900">
            Journal de Pesquisa
          </h1>
          <p class="text-gray-600 text-xs mt-1 uppercase tracking-widest font-bold">
            Notas, pesquisas e reflexões
          </p>
        </div>
      </div>
    </PaperCard>

    <BlogIntro />

    <SearchBar />

    <TagFilter {allTags} {posts} />

    <!-- Posts List -->
    <div class="space-y-6" id="posts-list">
      {posts.map((post) => (
        <PaperCard class="post-card p-6" data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()}>
          <div class="flex items-center gap-2 mb-3">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="font-mono text-[10px] text-gray-600 uppercase tracking-widest"
            >
              {post.data.pubDate.toLocaleDateString("pt-BR", { year: "numeric", month: "long", day: "numeric" })}
            </time>
            {post.data.tags && post.data.tags.length > 0 && (
              <>
                <span class="text-gray-600">·</span>
                {post.data.tags.map((tag) => (
                  <a href={`/blog/tag/${slugifyTag(tag)}`} data-astro-prefetch class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 hover:bg-teal-100 hover:text-teal-700 uppercase tracking-wider transition-colors">{tag}</a>
                ))}
              </>
            )}
          </div>
          <h2 class="text-xl sm:text-2xl font-display italic text-gray-900 mb-3">
            <a href={`/blog/${post.id}`} data-astro-prefetch class="hover:text-gray-700 transition-colors">{post.data.title}</a>
          </h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">{post.data.description}</p>
          <a href={`/blog/${post.id}`} data-astro-prefetch class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-700 hover:text-gray-900 transition-colors">
            Ler Artigo <Icon name="arrow-right" class="inline" size={10} />
          </a>
        </PaperCard>
      ))}
    </div>
  </article>
</BaseLayout>
