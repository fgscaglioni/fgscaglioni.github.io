---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import TagFilter from "../../components/TagFilter.astro";
import BlogIntro from "../../components/BlogIntro.astro";
import SearchBar from "../../components/SearchBar.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";
import { publishedPosts } from "../../utils/posts";

const posts = publishedPosts(await getCollection("blog"));

const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<BaseLayout
  title="Artigos de Pesquisa | Fabrício Scaglioni"
  description="Artigos e notas de Fabrício Scaglioni sobre inteligência artificial, aprendizado de máquina, engenharia de software e educação."
>
  <Navbar slot="header" />

  <article class="pt-8 pb-16">
    <section class="section section-first">
      <div class="flex items-center gap-4 relative">
        <div>
          <h1 class="text-3xl sm:text-4xl font-display text-ink">
            Artigos de Pesquisa
          </h1>
          <p class="text-ink-2 text-xs mt-1 uppercase tracking-widest font-bold">
            Notas, pesquisas e reflexões
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <BlogIntro />
    </section>

    <section class="section">
      <SearchBar />

      <TagFilter {allTags} {posts} />
    </section>

    <!-- Posts List -->
    <div id="posts-list">
      {posts.map((post) => (
        <PostCard {post} />
      ))}
    </div>
  </article>
</BaseLayout>
