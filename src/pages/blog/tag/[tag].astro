---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import TagFilter from "../../../components/TagFilter.astro";
import BlogIntro from "../../../components/BlogIntro.astro";
import SearchBar from "../../../components/SearchBar.astro";
import Icon from "../../../components/Icon.svelte";
import { getCollection } from "astro:content";
import { slugifyTag, tagSlugMap } from "../../../utils/tags";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft);
  const allTags = posts.flatMap((post) => post.data.tags || []);
  // Uma página por slug: "educação" e "educacao" deixam de gerar duas URLs.
  return [...tagSlugMap(allTags).entries()].map(([tag, label]) => ({
    params: { tag },
    props: { label },
  }));
}

const { tag } = Astro.params;
const { label } = Astro.props;

const allPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))].sort();

const posts = allPosts.filter((post) =>
  (post.data.tags || []).some((t) => slugifyTag(t) === tag)
);
---

<BaseLayout
  title={`Posts com a tag ${label} · Journal`}
  description={`Artigos do journal de Fabrício Scaglioni marcados com ${label}: ${posts.length} ${posts.length === 1 ? "publicação" : "publicações"} sobre pesquisa, engenharia de software e inteligência artificial.`}
  noindex={true}
>
  <Navbar slot="header" />

  <article class="pt-8 pb-16">
    <section class="section section-first">
      <div class="flex items-center gap-4 relative">
        <div>
          <h1 class="text-3xl sm:text-4xl font-display text-ink">
            Posts com a tag “{label}”
          </h1>
          <p class="text-ink-2 text-xs mt-1 uppercase tracking-widest font-bold">
            {posts.length} {posts.length === 1 ? "publicação" : "publicações"} no journal
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <BlogIntro />
    </section>

    <section class="section">
      <SearchBar />

      <TagFilter {allTags} {posts} activeTag={tag} />
    </section>

    <div>
      {posts.length === 0 && (
        <p class="text-ink-2 text-sm text-center py-12">Nenhum post encontrado com essa tag.</p>
      )}
      {posts.map((post) => (
        <section class="section post-card" data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()}>
          <div class="flex items-center gap-2 mb-3">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="font-mono text-[10px] text-ink-2 uppercase tracking-widest"
            >
              {post.data.pubDate.toLocaleDateString("pt-BR", { year: "numeric", month: "long", day: "numeric" })}
            </time>
            {post.data.tags && post.data.tags.length > 0 && (
              <>
                <span class="text-ink-2">·</span>
                {post.data.tags.map((t) => (
                  <a href={`/blog/tag/${slugifyTag(t)}`} class="font-mono text-[10px] px-2 py-0.5 border border-rule bg-paper-3 text-ink-2 hover:bg-rule hover:text-ink uppercase tracking-wider transition-colors">{t}</a>
                ))}
              </>
            )}
          </div>
          <h2 class="text-xl sm:text-2xl font-display text-ink mb-3">
            <a href={`/blog/${post.id}`} class="hover:text-ink-2 transition-colors">{post.data.title}</a>
          </h2>
          <p class="text-ink-2 text-sm leading-relaxed mb-4">{post.data.description}</p>
          <a href={`/blog/${post.id}`} class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink-2 hover:text-ink transition-colors">
            Ler Artigo <Icon name="arrow-right" class="inline" size={10} />
          </a>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
