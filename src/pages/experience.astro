---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import PaperCard from "../components/PaperCard.astro";
import PageHeader from "../components/PageHeader.astro";
import { experiences } from "../data/experienceData";
import BulletItem from "../components/BulletItem.astro";


---

<BaseLayout
  title="Experiência Profissional | Fabrício Scaglioni"
  description="Trajetória de Fabrício Scaglioni como engenheiro de software: arquitetura de sistemas, liderança técnica e projetos em produção desde 2006.">
  <Navbar slot="header" />

  <article class="pt-8 pb-16">
    <!-- Page Header -->
    <PageHeader kicker="Trajetória" title="Experiência Profissional" subtitle="Minha trajetória como desenvolvedor de sistemas desde 2006" />

    <!-- Timeline -->
    <div class="relative timeline-line pl-8 sm:pl-10 space-y-6">
      {experiences.map((exp) => (
        <div class="relative">
          <!-- Dot -->
          <div class={`absolute -left-[37px] sm:-left-[45px] w-2 h-2 border mt-2.5 transition-colors ${exp.current ? 'border-accent bg-accent' : 'border-rule-strong bg-paper-2'}`}>
          </div>

          <!-- Card -->
          <PaperCard class=" p-6">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-4 border-b border-rule pb-4">
              <div>
                <h3 class="text-xl sm:text-2xl font-display text-ink">{exp.role}</h3>
                <a href={exp.url} target="_blank" rel="noopener noreferrer" class="text-ink-2 hover:text-ink text-xs font-bold uppercase tracking-wider transition-colors inline-block mt-1 py-1">
                  {exp.company} <span class="text-ink-2 font-medium ml-1">({exp.tag})</span>
                </a>
              </div>
              <span class={`font-mono text-[10px] px-2.5 py-1 uppercase tracking-widest border flex-shrink-0 self-start ${exp.current ? 'text-accent border-accent' : 'bg-paper-3 text-ink-2 border-rule'}`}>
                {exp.period}
              </span>
            </div>
            <ul class="list-none space-y-3 mb-6">
              {exp.description.map(bullet => (
                <BulletItem>{bullet}</BulletItem>
              ))}
            </ul>
            {exp.skills.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-4 border-t border-rule border-dashed">
                {exp.skills.map(skill => (
                  <span class="px-2 py-0.5 rounded-none bg-paper-3 text-ink-2 text-[11px] uppercase font-bold tracking-wider border border-rule hover:border-rule transition-colors">
                    {skill}
                  </span>
                ))}
              </div>
            )}
          </PaperCard>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>
