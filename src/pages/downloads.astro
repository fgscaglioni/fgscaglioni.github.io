---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import PaperCard from "../components/PaperCard.astro";
import PageHeader from "../components/PageHeader.astro";
import { articles, dissertations } from "../data/downloadsData";
import SectionHeader from "../components/SectionHeader.astro";
import Icon from "../components/Icon.svelte";


---

<BaseLayout
  title="Downloads de Artigos Científicos | Fabrício Scaglioni"
  description="Artigos científicos completos em PDF, em primeira autoria e coautoria, com links para periódicos e anais de congressos.">
  <Navbar slot="header" />

  <article class="pt-8 pb-16">
    <!-- Page Header -->
    <PageHeader icon="download" title="Downloads" subtitle="Publicações acadêmicas, artigos e dissertações" />

    <!-- Articles -->
    <section class="mb-10">
      <SectionHeader icon="file-pdf" title="Artigos Publicados" />
      <div class="grid md:grid-cols-2 gap-5">
        {
          articles.map((category) => (
            <PaperCard class=" overflow-hidden">
              <div class="px-5 py-3 border-b border-rule flex items-center gap-2 bg-paper-3">
                <Icon name={category.icon} class={`${category.color} inline`} size={14} />
                <h3 class="font-bold text-ink-2 uppercase tracking-wider text-[10px]">{category.type}</h3>
              </div>
              <div class="p-5 space-y-6">
                {category.items.map((item) => (
                  <div>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block text-ink hover:text-ink font-serif text-lg leading-snug transition-colors mb-2"
                    >
                      {item.title}
                    </a>
                    <div class="flex flex-wrap items-center gap-3 mt-1 text-[11px] font-mono text-ink-2">
                      <span>{item.month}/{item.year}</span>
                      {item.event && (
                        <>
                          <span>/</span>
                          {item.event_url ? (
                            <a href={item.event_url} target="_blank" rel="noopener noreferrer" class="py-1 hover:text-ink transition-colors flex items-center gap-1">
                              {item.event}
                              <Icon name="external-link" class="inline" size={8} />
                            </a>
                          ) : (
                            <span>{item.event}</span>
                          )}
                        </>
                      )}
                      <span class="px-2 py-0.5 border border-rule bg-paper-3 text-ink-2 font-bold ml-auto">
                        {item.badge}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </PaperCard>
          ))
        }
      </div>
    </section>

    <!-- Dissertation -->
    <section>
      <SectionHeader icon="book" title="Dissertação de Mestrado" />
      {
        dissertations.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group paper-card p-6 flex flex-col sm:flex-row items-center gap-6 transition-colors duration-150"
          >
            <div class="w-16 h-20 rounded-none border border-rule bg-paper-3 flex items-center justify-center flex-shrink-0 group-hover:border-rule-strong transition-colors">
              <Icon name="book-open" class="inline text-ink-2 group-hover:text-ink transition-colors" size={28} />
            </div>
            <div class="flex-1 min-w-0 text-center sm:text-left">
              <p class="text-[10px] font-mono font-bold uppercase tracking-widest text-ink-2 mb-1">ANO: {item.year}</p>
              <h3 class="text-ink font-serif text-xl leading-snug group-hover:text-ink transition-colors">{item.title}</h3>
              <div class="flex items-center justify-center sm:justify-end gap-2 mt-4 text-ink-2 text-xs font-bold uppercase tracking-wider">
                <span>Acessar repositório</span>
                <Icon name="arrow-right" class="inline" size={16} />
              </div>
            </div>
          </a>
        ))
      }
    </section>
  </article>
</BaseLayout>
