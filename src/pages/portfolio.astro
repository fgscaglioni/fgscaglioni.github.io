---
import Icon from "../components/Icon.svelte";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import PageHeader from "../components/PageHeader.astro";
import { projects } from "../data/portfolioData";
import BulletItem from "../components/BulletItem.astro";


---

<BaseLayout
  title="Portfólio de Projetos | Fabrício Scaglioni"
  description="Projetos de software e pesquisas aplicadas de Fabrício Scaglioni: sistemas educacionais, APIs institucionais, aplicativos e modelos de IA.">
  <Navbar slot="header" />

  <article class="pt-8 pb-16">
    <!-- Page Header -->
    <PageHeader kicker="Projetos" title="Portfólio" subtitle="Projetos de Software, mobile e soluções Web em produção" />

    <p class="text-ink-2 text-xs mb-8 ml-1 italic">
      Alguns projetos corporativos sob acordos de confidencialidade (NDA) foram omitidos.
    </p>

    <!-- Projects -->
    <div>
      {
        projects.map((project) => (
          <section class="section">
            <!-- Header Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-rule">
              <div>
                <div class="flex items-center gap-3 mb-1">
                  <span class="font-mono text-[10px] px-2 py-0.5 border border-rule text-ink-2 uppercase tracking-widest bg-paper-3">
                    {project.year}
                  </span>
                  <span class="text-ink-2 text-xs uppercase tracking-wider">
                    {project.client}
                  </span>
                </div>
                <h2 class="text-2xl font-display text-ink">
                  {project.url ? (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-ink-2 transition-colors"
                    >
                      {project.name}
                    </a>
                  ) : (
                    project.name
                  )}
                </h2>
              </div>
              <div class="flex flex-wrap gap-1.5 sm:justify-end">
                {project.stack.map((tech) => (
                  <span class="px-2 py-0.5 rounded-none border border-rule bg-paper-3 text-ink-2 text-[11px] uppercase font-bold tracking-wider">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Content -->
            <div class="pt-5">
              <p class="text-ink-2 text-sm leading-relaxed mb-5 border-l-2 border-rule-strong pl-4">
                {project.summary}
              </p>
              <ul class="space-y-2.5 mb-6">
                {project.bullets.map((bullet) => (
                  <BulletItem>{bullet}</BulletItem>
                ))}
              </ul>

              {project.name === "My Safe Back" && (
                <div class="mb-6 pt-2">
                  <a
                    href="https://doi.org/10.1016/j.bjpt.2025.101232"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 py-1 text-xs font-bold uppercase tracking-wider text-ink-2 hover:text-ink transition-colors"
                  >
                    <Icon name="file-text" class="text-ink-3 inline" /> Acessar Artigo Publicado (BJPT)
                  </a>
                </div>
              )}

              <!-- Screenshots Gallery -->
              {project.screenshots.length > 0 && (
                <div class="border-t border-rule pt-5">
                  <p class="text-ink-2 text-[11px] uppercase tracking-widest font-bold mb-4">
                    Screenshots
                  </p>
                  <div
                    class={`flex gap-3 overflow-x-auto pb-2 ${
                      project.screenshotType === "mobile"
                        ? "items-end"
                        : "items-start"
                    }`}
                  >
                    {project.screenshots.map((img: any, i) => (
                      <div
                        class={`flex-shrink-0 border border-rule rounded-none overflow-hidden transition-colors duration-200 hover:border-rule-strong ${
                          project.screenshotType === "mobile"
                            ? "w-32"
                            : "w-64"
                        }`}
                      >
                        <img
                          src={img.src}
                          alt={`${project.name} screenshot ${i + 1}`}
                          class="w-full h-auto object-cover grayscale hover:grayscale-0 transition-colors duration-150"
                          loading="lazy"
                        />
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>