---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Icon from "../components/Icon.svelte";

const socialLinks = [
  {
    name: "GitHub",
    url: "http://github.com/fgscaglioni/",
    icon: "github",
    color: "bg-paper-3 border-rule hover:border-rule-strong",
    iconColor: "text-ink-2",
  },
  {
    name: "Medium",
    url: "https://medium.com/@fgscaglioni",
    icon: "medium",
    color: "bg-paper-3 border-rule hover:border-rule-strong",
    iconColor: "text-ink-2",
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/fgscaglioni/",
    icon: "linkedin",
    color: "bg-paper-3 border-rule hover:border-rule-strong",
    iconColor: "text-ink-2",
  },
  {
    name: "X (Twitter)",
    url: "https://x.com/fgscaglioni",
    icon: "x-twitter",
    color: "bg-paper-3 border-rule hover:border-rule-strong",
    iconColor: "text-ink-2",
  },
  {
    name: "Instagram",
    url: "https://www.instagram.com/fgscaglioni",
    icon: "instagram",
    color: "bg-paper-3 border-rule hover:border-rule-strong",
    iconColor: "text-ink-2",
  },
];

const academicLinks = [
  {
    name: "Google Scholar",
    url: "https://scholar.google.com/citations?user=fZEKGvUAAAAJ",
    icon: "google",
    desc: "Publicações e citações acadêmicas",
    color: "text-ink-2",
  },
  {
    name: "Lattes",
    url: "https://lattes.cnpq.br/0870115674210417",
    icon: "id-card",
    desc: "Currículo Lattes CNPq",
    color: "text-ink-2",
  },
  {
    name: "Orcid",
    url: "https://orcid.org/0000-0002-9749-2077",
    icon: "id-badge",
    desc: "Identificador de pesquisador",
    color: "text-ink-2",
  },
  {
    name: "Kaggle",
    url: "https://www.kaggle.com/fgscaglioni",
    icon: "k",
    desc: "Competições e notebooks de ML",
    color: "text-ink-2",
  },
  {
    name: "ResearchGate",
    url: "https://www.researchgate.net/profile/Fabricio-Scaglioni",
    icon: "r",
    desc: "Rede de colaboração científica",
    color: "text-ink-2",
  },
  {
    name: "Parsifal",
    url: "https://parsif.al/fgscaglioni/",
    icon: "magnifying-glass-chart",
    desc: "Revisões sistemáticas da literatura",
    color: "text-ink-2",
  },
  {
    name: "Semantic Scholar",
    url: "https://www.semanticscholar.org/author/2202206947",
    icon: "graduation-cap",
    desc: "Pesquisa acadêmica com IA",
    color: "text-ink-2",
  },
  {
    name: "ResearchId",
    url: "https://researchid.co/fgscaglioni",
    icon: "fingerprint",
    desc: "Perfil unificado de pesquisador",
    color: "text-ink-2",
  },
];
---

<BaseLayout
  title="Redes Sociais & Científicas | Fabrício Scaglioni"
  description="Perfis de Fabrício Scaglioni no GitHub, LinkedIn, Google Scholar, ORCID, Lattes, ResearchGate e outras redes profissionais e acadêmicas.">
  <Navbar slot="header" />

  <article class="pt-8 pb-16">
    <PageHeader kicker="Perfis" title="Redes Sociais & Científicas" subtitle="Perfis profissionais, pessoais e acadêmicos" />

    <section class="section section-first">
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <SectionHeader title="Redes Sociais" />
          <div class="divide-y divide-rule">
            {socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 py-3 transition-colors duration-150"
              >
                <div class="w-10 h-10 rounded-none border border-rule bg-paper-3 group-hover:bg-rule flex items-center justify-center flex-shrink-0 transition-colors">
                  <Icon name={link.icon} class={link.iconColor} size={20} />
                </div>
                <span class="text-ink-2 font-bold uppercase tracking-wider text-xs group-hover:text-ink transition-colors">
                  {link.name}
                </span>
              </a>
            ))}
          </div>
        </div>

        <div>
          <SectionHeader title="Redes Acadêmicas" />
          <div class="divide-y divide-rule">
            {academicLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 py-3 transition-colors duration-200"
              >
                <div class="w-8 h-8 rounded-none border border-rule bg-paper-3 group-hover:bg-rule flex items-center justify-center flex-shrink-0 transition-colors">
                  <Icon name={link.icon} class={link.color} size={16} />
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-ink-2 font-bold uppercase tracking-wider text-xs group-hover:text-ink transition-colors">
                    {link.name}
                  </div>
                  <div class="text-ink-2 font-light text-[11px] truncate mt-1">
                    {link.desc}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>