---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Icon from "../components/Icon.svelte";
import StackList from "../components/StackList.astro";
import BulletItem from "../components/BulletItem.astro";
import { getCollection } from "astro:content";

// Posts mais recentes: dá sinal interno (e caminho de descoberta) para o conteúdo do journal.
const latestPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && !post.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Fabrício Scaglioni | Engenheiro de Software e Pesquisador"
  description="Portfólio de Fabrício Scaglioni: engenheiro de software sênior e doutorando em IA na UFPel. Projetos, publicações científicas e journal de pesquisa."
>
  <Navbar slot="header" />

  <article class="pt-8 pb-4">
    <!-- Hero: primeira secao, nao repete o fio que o cabecalho ja desenhou -->
    <section class="section section-first">
      <div
        class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-6"
      >
        <!-- Avatar -->
        <div class="flex-shrink-0">
          <img
            src="/avatar.webp"
            alt="Fabrício Scaglioni"
            width="96"
            height="96"
            fetchpriority="high"
            decoding="async"
            class="w-24 h-24 object-cover border border-rule grayscale"
          />
        </div>
        <!-- Info -->
        <div class="flex-grow">
          <div class="flex flex-col sm:flex-row items-center gap-3 mb-2">
            <h1 class="text-h1 font-display text-ink">
              Fabrício Scaglioni
            </h1>
            <span class="inline-flex items-center gap-1.5 text-label text-ink-3 uppercase">
              <span class="w-1.5 h-1.5 bg-accent inline-block"></span> Disponível
            </span>
          </div>
          <!-- Positioning Tagline -->
          <p class="text-ink-2 text-sm mb-4 font-mono uppercase tracking-wider leading-relaxed">
            Engenheiro de Software Sênior&nbsp;·&nbsp;Pesquisador em IA
          </p>
          <!-- Social Links -->
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <a
              href="https://www.linkedin.com/in/fgscaglioni/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-1.5 border border-rule bg-paper-3 hover:bg-paper-2 hover:text-ink text-xs font-bold uppercase tracking-wider transition-colors duration-150"
            >
              <Icon name="linkedin" class="inline" /> LinkedIn
            </a>
            <a
              href="https://github.com/fgscaglioni/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-1.5 border border-rule bg-paper-3 hover:bg-paper-2 hover:text-ink text-xs font-bold uppercase tracking-wider transition-colors duration-150"
            >
              <Icon name="github" class="inline" /> GitHub
            </a>
            <a
              href="https://medium.com/@fgscaglioni"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-1.5 border border-rule bg-paper-3 hover:bg-paper-2 hover:text-ink text-xs font-bold uppercase tracking-wider transition-colors duration-150"
            >
              <Icon name="medium" class="inline" /> Medium
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- About + Technical Approach: cada coluna abre com o proprio fio -->
    <div class="grid md:grid-cols-2 gap-x-10">
      <section class="section">
        <h2 class="text-h2 font-display text-ink">Sobre mim</h2>
        <ul class="space-y-3">
          <BulletItem><strong class="text-ink font-medium">+15 anos</strong> atuando em
              todo o ciclo de desenvolvimento — planejamento, arquitetura, frontend
              e backend.</BulletItem>
          <BulletItem><strong class="text-ink font-medium"
                >Doutorando em Ciência da Computação</strong
              > (UFPel), pesquisando <strong class="text-ink font-medium"
                >Inteligência Artificial aplicada à Educação</strong
              >.</BulletItem>
          <BulletItem>Experiência em escalar sistemas em produção — de aplicativos com <strong
                class="text-ink font-medium">+2k usuários</strong
              > a APIs institucionais de alta escala.</BulletItem>
        </ul>
      </section>

      <section class="section">
        <h2 class="text-h2 font-display text-ink">Competências Chave</h2>
        <ul class="space-y-3">
          <BulletItem><strong class="text-ink font-medium"
                >Arquitetura de Software</strong
              > — design e implementação de APIs REST, sistemas containerizados com
              Docker e pipelines CI/CD.</BulletItem>
          <BulletItem><strong class="text-ink font-medium"
                >Desenvolvimento Fullstack</strong
              > — Laravel, NestJS, Angular, Ionic e PostgreSQL como stacks principais.</BulletItem>
          <BulletItem><strong class="text-ink font-medium">Pesquisa em ML/IA</strong> —
              modelos preditivos educacionais, SLMs e revisões sistemáticas publicadas
              em periódicos internacionais.</BulletItem>
        </ul>
      </section>
    </div>

    <!-- Stack Section -->
    <section class="section">
      <h2 class="text-h2 font-display text-ink">Stack</h2>
      <StackList />
    </section>

    <!-- Latest Posts: liga a home ao conteúdo do journal -->
    {latestPosts.length > 0 && (
      <section class="section">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-h2 font-display text-ink">Últimos Artigos</h2>
          <a
            href="/blog"
            data-astro-prefetch
            class="inline-flex items-center gap-1.5 py-1 text-xs font-bold uppercase tracking-wider text-ink-2 hover:text-ink transition-colors"
          >
            Ver todos <Icon name="arrow-right" class="inline" size={10} />
          </a>
        </div>
        <div class="space-y-5">
          {latestPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              data-astro-prefetch
              class="block group border-t border-rule pt-5"
            >
              <div class="flex items-center gap-2 mb-2">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-mono text-[10px] text-ink-2 uppercase tracking-widest"
                >
                  {post.data.pubDate.toLocaleDateString("pt-BR", { year: "numeric", month: "short" })}
                </time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <>
                    <span class="text-ink-2">·</span>
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="font-mono text-[10px] px-2 py-0.5 border border-rule bg-paper-3 text-ink-2 uppercase tracking-wider">
                        {tag}
                      </span>
                    ))}
                  </>
                )}
              </div>
              <h3 class="text-base font-display text-ink group-hover:text-accent transition-colors">
                {post.data.title}
              </h3>
              <p class="text-ink-2 text-xs mt-2 leading-relaxed">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Education + Languages -->
    <div class="grid md:grid-cols-2 gap-x-10">
      <section class="section">
        <h2 class="text-h2 font-display text-ink">Formação Acadêmica</h2>
        <div class="space-y-4">
          {
            [
              {
                inst: "UFPel",
                href: "https://institucional.ufpel.edu.br/cursos/cod/8102",
                level: "Doutorado em Ciência da Computação",
                period: "2024 - Cursando",
                ariaLabel: "UFPel — Doutorado em Ciência da Computação",
              },
              {
                inst: "i9",
                href: "#",
                level: "Pós-Graduação em Direito Público",
                period: "2024 - 2026",
                ariaLabel: "i9 — Pós-Graduação em Direito Público",
              },
              {
                inst: "UFPel",
                href: "https://institucional.ufpel.edu.br/cursos/cod/7057",
                level: "Mestrado em Ciência da Computação",
                period: "2019 - 2021",
                ariaLabel: "UFPel — Mestrado em Ciência da Computação",
              },
              {
                inst: "UniSenac",
                href: "https://www.senacrs.com.br/unidade/78",
                level: "Especialização em Gerenciamento de Projetos",
                period: "2009 - 2010",
                ariaLabel: "UniSenac — Especialização em Gerenciamento de Projetos",
              },
              {
                inst: "UniSenac",
                href: "https://www.senacrs.com.br/unidade/78",
                level: "Tecnólogo em Análise e Desenvolvimento de Sistemas",
                period: "2005 - 2007",
                ariaLabel: "UniSenac — Tecnólogo em Análise e Desenvolvimento de Sistemas",
              },
            ].map((item) => (
              <div class="flex items-start gap-3">
                <div class="mt-1 flex-shrink-0">
                  <Icon name="circle-dot" class="text-ink-3 inline" />
                </div>
                <div>
                  <a
                    href={item.href}
                    target="_blank"
                    aria-label={item.ariaLabel}
                    class="text-ink text-sm font-medium hover:text-ink transition-colors"
                  >
                    {item.inst}
                  </a>
                  <p class="text-ink-2 font-light text-xs">{item.level}</p>
                  <p class="text-ink-2 text-[11px] font-mono mt-0.5 tracking-wider">
                    {item.period}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <div>
        <section class="section">
          <h2 class="text-h2 font-display text-ink">Idiomas</h2>
          <div class="divide-y divide-rule">
            {
              [
                { lang: "Português", level: "Nativo" },
                { lang: "Inglês", level: "Intermediário (Limited Working)" },
                { lang: "Espanhol", level: "Básico (Elementary)" },
                { lang: "Francês", level: "Básico (Elementary)" },
              ].map((item) => (
                <div class="flex justify-between items-baseline gap-4 py-2">
                  <span class="text-xs text-ink-2 font-medium">
                    {item.lang}
                  </span>
                  <span class="text-[11px] font-mono text-ink-2 uppercase tracking-widest text-right">
                    {item.level}
                  </span>
                </div>
              ))
            }
          </div>
        </section>

        <section class="section">
          <h2 class="text-h2 font-display text-ink">Certificações</h2>
          <div class="space-y-3">
            {
              [
                {
                  name: "OFICIAL EXIN PDPF",
                  details: "Privacy & Data Protection Foundation EAD",
                },
                {
                  name: "LGPD",
                  details: "Fundamentos da Lei Geral de Proteção de Dados",
                },
                { name: "HTML5", details: "W3C / Desenvolvimento Web" },
                {
                  name: "Angular 2 Fundamentals",
                  details: "TypeScript Framework Core",
                },
                {
                  name: "Ionic 3",
                  details: "Desenvolvimento Híbrido Intermediário",
                },
              ].map((cert) => (
                <div class="flex items-start gap-2">
                  <Icon name="shield-halved" class="text-ink-3 mt-1.5 inline" />
                  <div>
                    <h3 class="text-ink text-xs font-medium">
                      {cert.name}
                    </h3>
                    <p class="text-ink-2 font-light text-[11px]">
                      {cert.details}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
