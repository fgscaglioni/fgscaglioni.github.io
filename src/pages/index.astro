---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Icon from "../components/Icon.svelte";
import StackList from "../components/StackList.astro";
import PaperCard from "../components/PaperCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BulletItem from "../components/BulletItem.astro";
import { getCollection } from "astro:content";

// Posts mais recentes: dá sinal interno (e caminho de descoberta) para o conteúdo do journal.
const latestPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && !post.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Fabrício Scaglioni | Engenheiro de Software e Pesquisador"
  description="Portfólio de Fabrício Scaglioni: engenheiro de software sênior e doutorando em IA na UFPel. Projetos, publicações científicas e journal de pesquisa."
>
  <Navbar slot="header" />

  <article class="pt-8 pb-4">
    <!-- Hero Section -->
    <section class="paper-card p-6 sm:p-8 mb-6 relative overflow-hidden">
      <!-- Light aura inside card -->
      <div
        class="absolute -right-10 -top-10 w-40 h-40 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>

      <div
        class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-6 relative"
      >
        <!-- Avatar -->
        <div class="relative flex-shrink-0">
          <img
            src="/avatar.webp"
            alt="Fabrício Scaglioni"
            width="96"
            height="96"
            fetchpriority="high"
            decoding="async"
            class="relative w-24 h-24 rounded-full object-cover border border-gray-200 shadow-xl transition-transform duration-500 hover:scale-105"
          />
        </div>
        <!-- Info -->
        <div class="flex-grow">
          <div class="flex flex-col sm:flex-row items-center gap-3 mb-2">
            <h1
              class="text-3xl sm:text-4xl text-gray-900 font-display italic tracking-wide"
            >
              Fabrício Scaglioni
            </h1>
            <span
              class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full border border-emerald-600/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 text-[9px] uppercase font-bold tracking-wider"
            >
              <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"
              ></span> Disponível
            </span>
          </div>
          <!-- Positioning Tagline -->
          <p
            class="text-gray-500 text-sm mb-4 font-mono uppercase tracking-wider leading-relaxed"
          >
            Engenheiro de Software Sênior&nbsp;·&nbsp;Pesquisador em IA
          </p>
          <!-- Social Links -->
          <div
            class="flex flex-wrap items-center justify-center sm:justify-start gap-2"
          >
            <a
              href="https://www.linkedin.com/in/fgscaglioni/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-200 bg-gray-50 hover:bg-white hover:text-black text-xs font-bold uppercase tracking-wider transition-colors duration-300"
            >
              <Icon name="linkedin" class="inline" /> LinkedIn
            </a>
            <a
              href="https://github.com/fgscaglioni/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-200 bg-gray-50 hover:bg-white hover:text-black text-xs font-bold uppercase tracking-wider transition-colors duration-300"
            >
              <Icon name="github" class="inline" /> GitHub
            </a>
            <a
              href="https://medium.com/@fgscaglioni"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-200 bg-gray-50 hover:bg-white hover:text-black text-xs font-bold uppercase tracking-wider transition-colors duration-300"
            >
              <Icon name="medium" class="inline" /> Medium
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- About + Technical Approach side by side on desktop, stacked on mobile -->
    <div class="grid md:grid-cols-2 gap-6 mb-6">
      <section class="paper-card p-6">
        <SectionHeader icon="user" title="
            Sobre mim
          " />
        <ul class="space-y-3">
          <BulletItem><strong class=&quot;text-gray-900 font-medium&quot;>+15 anos</strong> atuando em
              todo o ciclo de desenvolvimento — planejamento, arquitetura, frontend
              e backend.</BulletItem>
          <BulletItem><strong class=&quot;text-gray-900 font-medium&quot;
                >Doutorando em Ciência da Computação</strong
              > (UFPel), pesquisando <strong class=&quot;text-gray-900 font-medium&quot;
                >Inteligência Artificial aplicada à Educação</strong
              >.</BulletItem>
          <BulletItem>Experiência em escalar sistemas em produção — de aplicativos com <strong
                class=&quot;text-gray-900 font-medium&quot;>+2k usuários</strong
              > a APIs institucionais de alta escala.</BulletItem>
        </ul>
      </section>

      <section class="paper-card p-6">
        <SectionHeader icon="code" title="
            Competências Chave
          " />
        <ul class="space-y-3">
          <BulletItem><strong class=&quot;text-gray-900 font-medium&quot;
                >Arquitetura de Software</strong
              > — design e implementação de APIs REST, sistemas containerizados com
              Docker e pipelines CI/CD.</BulletItem>
          <BulletItem><strong class=&quot;text-gray-900 font-medium&quot;
                >Desenvolvimento Fullstack</strong
              > — Laravel, NestJS, Angular, Ionic e PostgreSQL como stacks principais.</BulletItem>
          <BulletItem><strong class=&quot;text-gray-900 font-medium&quot;>Pesquisa em ML/IA</strong> —
              modelos preditivos educacionais, SLMs e revisões sistemáticas publicadas
              em periódicos internacionais.</BulletItem>
        </ul>
      </section>
    </div>

    <!-- Stack Section -->
    <section class="mb-8">
      <h2 class="text-2xl font-display italic text-gray-900 tracking-wide mb-6">
        Stack
      </h2>
      <StackList />
    </section>

    <!-- Latest Posts: liga a home ao conteúdo do journal -->
    {latestPosts.length > 0 && (
      <section class="mb-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-display italic text-gray-900 tracking-wide">
            Últimos Artigos
          </h2>
          <a
            href="/blog"
            data-astro-prefetch
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-700 hover:text-gray-900 transition-colors"
          >
            Ver todos <Icon name="arrow-right" class="inline" size={10} />
          </a>
        </div>
        <div class="space-y-4">
          {latestPosts.map((post) => (
            <a href={`/blog/${post.id}`} data-astro-prefetch class="block group">
              <PaperCard class="p-5 transition-shadow duration-200 group-hover:shadow-md">
                <div class="flex items-center gap-2 mb-2">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="font-mono text-[9px] text-gray-500 uppercase tracking-widest"
                  >
                    {post.data.pubDate.toLocaleDateString("pt-BR", { year: "numeric", month: "short" })}
                  </time>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <>
                      <span class="text-gray-400">·</span>
                      {post.data.tags.slice(0, 2).map((tag) => (
                        <span class="font-mono text-[9px] px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 uppercase tracking-wider">
                          {tag}
                        </span>
                      ))}
                    </>
                  )}
                </div>
                <h3 class="text-base font-display italic text-gray-900 group-hover:text-teal-600 transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-gray-500 text-xs mt-2 leading-relaxed">{post.data.description}</p>
              </PaperCard>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Education + Languages -->
    <div class="grid md:grid-cols-2 gap-6">
      <section class="paper-card p-6">
        <SectionHeader icon="graduation-cap" title="Formação Acadêmica" />
        <div class="space-y-4">
          {
            [
              {
                inst: "UFPel",
                href: "https://institucional.ufpel.edu.br/cursos/cod/8102",
                level: "Doutorado em Ciência da Computação",
                period: "2024 - Cursando",
                icon: "circle-dot",
              },
              {
                inst: "i9",
                href: "#",
                level: "Pós-Graduação em Direito Público",
                period: "2024 - 2026",
                icon: "circle-dot",
              },
              {
                inst: "UFPel",
                href: "https://institucional.ufpel.edu.br/cursos/cod/7057",
                level: "Mestrado em Ciência da Computação",
                period: "2019 - 2021",
                icon: "circle-dot",
              },
              {
                inst: "UniSenac",
                href: "https://www.senacrs.com.br/unidade/78",
                level: "Especialização em Gerenciamento de Projetos",
                period: "2009 - 2010",
                icon: "square",
              },
              {
                inst: "UniSenac",
                href: "https://www.senacrs.com.br/unidade/78",
                level: "Tecnólogo em Análise e Desenvolvimento de Sistemas",
                period: "2005 - 2007",
                icon: "square",
              },
            ].map((item) => (
              <div class="flex items-start gap-3">
                <div class="mt-1 flex-shrink-0">
                  <Icon name={item.icon} class="text-[8px] text-rose-500 inline" />
                </div>
                <div>
                  <a
                    href={item.href}
                    target="_blank"
                    class="text-gray-800 dark:text-gray-200 text-sm font-medium hover:text-gray-900 dark:hover:text-gray-300 transition-colors"
                  >
                    {item.inst}
                  </a>
                  <p class="text-gray-500 font-light text-xs">{item.level}</p>
                  <p class="text-gray-500 text-[10px] font-mono mt-0.5 tracking-wider">
                    {item.period}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <div class="space-y-6 flex flex-col justify-between">
        <section class="paper-card p-6 flex-grow">
          <SectionHeader icon="globe" title="Idiomas" />
          <div class="space-y-3">
            {
              [
                {
                  lang: "Português",
                  level: "Nativo",
                  pct: 100,
                },
                {
                  lang: "Inglês",
                  level: "Intermediário (Limited Working)",
                  pct: 65,
                },
                {
                  lang: "Espanhol",
                  level: "Básico (Elementary)",
                  pct: 35,
                },
                {
                  lang: "Francês",
                  level: "Básico (Elementary)",
                  pct: 25,
                },
              ].map((item) => (
                <div>
                  <div class="flex justify-between items-center mb-1">
                    <span class="text-xs text-gray-700 font-medium">
                      {item.lang}
                    </span>
                    <span class="text-[10px] font-mono text-gray-500 uppercase tracking-widest">
                      {item.level}
                    </span>
                  </div>
                  <div class="w-full bg-gray-200 border border-gray-100 rounded-full h-1.5">
                    <div
                      class="bg-teal-600 rounded-full h-full"
                      style={`width: ${item.pct}%`}
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section class="paper-card p-6 flex-grow">
          <SectionHeader icon="certificate" title="Certificações" />
          <div class="space-y-3">
            {
              [
                {
                  name: "OFICIAL EXIN PDPF",
                  details: "Privacy & Data Protection Foundation EAD",
                },
                {
                  name: "LGPD",
                  details: "Fundamentos da Lei Geral de Proteção de Dados",
                },
                { name: "HTML5", details: "W3C / Desenvolvimento Web" },
                {
                  name: "Angular 2 Fundamentals",
                  details: "TypeScript Framework Core",
                },
                {
                  name: "Ionic 3",
                  details: "Desenvolvimento Híbrido Intermediário",
                },
              ].map((cert) => (
                <div class="flex items-start gap-2">
                  <Icon name="shield-halved" class="text-[8px] text-rose-500 mt-1.5 inline" />
                  <div>
                    <h3 class="text-gray-800 dark:text-gray-200 text-xs font-medium">
                      {cert.name}
                    </h3>
                    <p class="text-gray-500 font-light text-[10px]">
                      {cert.details}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
