const brand = brandSvg[name];

if (import.meta.env.DEV && !inner && !brand) {
  console.warn('[Icon] ícone desconhecido: "' + name + '"');
}
---

{brand ? (
  <span class={className} style={`display:inline-flex;width:${size}px;height:${size}px`} set:html={brand} />
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
    set:html={inner ?? lucideInner["square"]}
  />
)}
