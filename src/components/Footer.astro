---
import Icon from "./Icon.svelte";
const year = new Date().getFullYear();
---

<footer class="mt-16 pb-12 text-center">
  <div class="h-px bg-gray-200 max-w-xs mx-auto mb-8"></div>
  <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-gray-600">
    <span>© {year} Fabrício Scaglioni</span>
    <a href="/rss.xml" class="inline-flex items-center gap-1 py-1 hover:text-gray-900 transition-colors">
      <Icon name="file-text" size={12} class="inline" />
      RSS
    </a>
    <a href="/changelog/" class="py-1 hover:text-gray-900 transition-colors">Modificações</a>
  </div>
</footer>
