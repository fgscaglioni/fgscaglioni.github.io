---
interface Props {
  href: string;
  label: string;
  currentPath: string;
  class?: string;
}

const { href, label, currentPath, class: className = "" } = Astro.props;

const isActive = href === "/"
  ? currentPath === "/"
  : currentPath === href || currentPath === href + "/" || currentPath.startsWith(href + "/");
---

<a
  href={href}
  data-astro-prefetch
  class:list={[
    className,
    isActive
      ? "bg-ink text-paper"
      : "text-ink-2 hover:text-ink hover:bg-paper-3"
  ]}
>
  {label}
</a>
