---
interface Props {
  href: string;
  label: string;
  currentPath: string;
  class?: string;
}

const { href, label, currentPath, class: className = "" } = Astro.props;

// "/" so casa na home. As demais rotas aceitam subcaminho (/blog/tag/... ativa
// o Journal), mas exigem a barra depois do href para nao casar prefixo por acidente.
const isActive = href === "/"
  ? currentPath === "/"
  : currentPath === href || currentPath.startsWith(href + "/");
---

<a
  href={href}
  data-astro-prefetch
  aria-current={isActive ? "page" : undefined}
  class:list={[
    "inline-flex items-center border-b-2 transition-colors duration-150",
    isActive
      ? "border-accent text-accent"
      : "border-transparent text-ink-2 hover:text-ink",
    className,
  ]}
>
  {label}
</a>
