---
import { slugifyTag, sortTagsByFrequency } from "../utils/tags";

interface Props {
  allTags: string[];
  activeTag?: string;
  posts: any[];
}

const { allTags, activeTag, posts } = Astro.props;
const sorted = sortTagsByFrequency(allTags, posts);
const top5 = sorted.slice(0, 5);
const rest = sorted.slice(5);
// activeTag chega como slug (vindo da rota); compara sempre por slug.
const isActive = (tag: string) => !!activeTag && slugifyTag(tag) === activeTag;
---

<div class="flex flex-wrap items-center gap-2 mb-8">
  <a
    href="/blog"
    data-astro-prefetch
    class={`px-3 py-1.5 border text-xs font-bold uppercase tracking-wider transition-colors duration-200 ${
      !activeTag
        ? "bg-ink text-paper border-ink"
        : "bg-paper-3 text-ink-2 border-rule hover:text-ink"
    }`}
  >
    Todos
  </a>

  {top5.map((tag) => (
    <a
      href={`/blog/tag/${slugifyTag(tag)}`}
      data-astro-prefetch
      class={`px-3 py-1.5 border text-xs font-bold uppercase tracking-wider transition-colors duration-200 ${
        isActive(tag)
          ? "bg-ink text-paper border-ink"
          : "bg-paper-3 text-ink-2 border-rule hover:text-ink"
      }`}
    >
      {tag}
    </a>
  ))}

  {rest.length > 0 && (
    <details class="relative tag-popover">
      <summary class="px-3 py-1.5 border border-rule text-xs font-bold uppercase tracking-wider cursor-pointer bg-paper-3 text-ink-2 hover:text-ink transition-colors duration-200 list-none">
        +{rest.length} mais
      </summary>
      <div class="absolute top-full right-0 mt-2 p-3 bg-paper-2 border border-rule z-50 flex flex-wrap gap-2 min-w-[200px]">
        {rest.map((tag) => (
          <a
            href={`/blog/tag/${slugifyTag(tag)}`}
            data-astro-prefetch
            class={`px-3 py-1.5 border text-xs font-bold uppercase tracking-wider transition-colors duration-200 whitespace-nowrap ${
              isActive(tag)
                ? "bg-ink text-paper border-ink"
                : "bg-paper-3 text-ink-2 border-rule hover:text-ink"
            }`}
          >
            {tag}
          </a>
        ))}
      </div>
    </details>
  )}
</div>
