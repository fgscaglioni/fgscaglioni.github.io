---
interface Props {
  title: string;
  subtitle?: string;
  kicker?: string;
  class?: string;
}
const { title, subtitle, kicker, class: className = "" } = Astro.props;
---

<header class={`border-b border-rule pb-6 mb-8 ${className}`}>
  {kicker && <p class="label mb-2">{kicker}</p>}
  <h1 class="text-h1 font-display text-ink">{title}</h1>
  {subtitle && <p class="mt-2 text-ink-3 text-meta">{subtitle}</p>}
</header>
