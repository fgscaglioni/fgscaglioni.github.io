---
import PaperCard from "./PaperCard.astro";
import Icon from "./Icon.svelte";

interface Props {
  icon: string;
  title: string;
  subtitle: string;
  class?: string;
}

const { icon, title, subtitle, class: className = "" } = Astro.props;
---

<PaperCard class="p-6 sm:p-8 mb-8 relative overflow-hidden {className}">
  <div class="flex items-center gap-4 relative">
    <div class="w-12 h-12 rounded-none border border-rule bg-paper-3 flex items-center justify-center flex-shrink-0">
      <Icon name={icon} class="text-ink-2" size={20} />
    </div>
    <div>
      <h1 class="text-3xl sm:text-4xl font-display italic tracking-wide text-ink">{title}</h1>
      <p class="text-ink-2 text-xs mt-1 uppercase tracking-widest font-bold">{subtitle}</p>
    </div>
  </div>
</PaperCard>