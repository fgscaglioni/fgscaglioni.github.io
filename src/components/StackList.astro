---
import { my_stack } from "../data/siteData";
---

{/*
  Lista de texto, nao parede de logos. Logo de tecnologia envelhece em dois anos
  (o mark do Laravel, do NestJS e do Svelte ja mudaram), custa contraste e nao
  carrega informacao que o nome nao carregue.
*/}
<ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-meta uppercase tracking-wider text-ink-3">
  {my_stack.map((item) => (
    <li>
      {item.url ? (
        <a href={item.url} target="_blank" rel="noopener noreferrer" class="underline decoration-rule decoration-1 underline-offset-4 hover:text-ink hover:decoration-ink transition-colors duration-150">
          {item.name}
        </a>
      ) : (
        item.name
      )}
    </li>
  ))}
</ul>
