---
import { siteLinks } from "../data/siteData";
import PaperCard from "../components/PaperCard.astro";
import NavLink from "../components/NavLink.astro";
import Icon from "../components/Icon.svelte";
const currentPath = Astro.url.pathname;
---

<header class="sticky top-4 z-50 px-4 max-w-4xl mx-auto w-full">
  <PaperCard class="px-4 py-3 flex items-center justify-between bg-white/80 backdrop-blur-md border border-gray-200 rounded-full">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <div class="w-8 h-8 rounded-full border border-gray-200 bg-gray-100 flex items-center justify-center transition-all duration-300 group-hover:bg-teal-600 group-hover:border-teal-600">
        <span class="font-display italic text-base font-bold text-gray-700 group-hover:text-white">fg</span>
      </div>
      <span class="font-display italic text-lg text-gray-800 group-hover:text-gray-500 transition-colors hidden lg:inline">
        fgscaglioni
      </span>
    </a>

    <!-- Desktop Navigation + Toggle -->
    <nav id="desktop-nav" class="hidden lg:flex items-center gap-1">
      {siteLinks.main.map((link) => (
        <NavLink
          href={link.href}
          label={link.label}
          currentPath={currentPath}
          class="px-2.5 py-1.5 rounded-full text-sm font-medium tracking-wide transition-all duration-300"
        />
      ))}
      <button
        id="theme-toggle"
        class="ml-1 w-8 h-8 rounded-full flex items-center justify-center text-gray-500 hover:text-gray-800 hover:bg-gray-100 transition-all duration-300"
        aria-label="Alternar tema"
      >
        <Icon name="moon" size={14} class="dark:hidden" />
        <Icon name="sun" size={14} class="hidden dark:block" />
      </button>
    </nav>

    <!-- Mobile: Hamburger + Toggle -->
    <div class="flex lg:hidden items-center gap-1">
      <button
        id="theme-toggle-mobile"
        class="w-8 h-8 rounded-full flex items-center justify-center text-gray-500 hover:text-gray-800 hover:bg-gray-100 transition-all duration-300"
        aria-label="Alternar tema"
      >
        <Icon name="moon" size={14} class="dark:hidden" />
        <Icon name="sun" size={14} class="hidden dark:block" />
      </button>
      <button
        id="menu-toggle"
        class="w-8 h-8 rounded-full flex items-center justify-center text-gray-500 hover:text-gray-800 hover:bg-gray-100 transition-all duration-300"
        aria-label="Abrir menu"
      >
        <span id="menu-icon-open"><Icon name="bars" size={14} /></span>
        <span id="menu-icon-close" class="hidden"><Icon name="xmark" size={14} /></span>
      </button>
    </div>
  </PaperCard>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="lg:hidden hidden mt-2">
    <PaperCard class="px-4 py-3 flex flex-col gap-1">
      {siteLinks.main.map((link) => (
        <NavLink
          href={link.href}
          label={link.label}
          currentPath={currentPath}
          class="px-3 py-2 rounded-xl text-sm font-medium tracking-wide transition-all duration-200"
        />
      ))}
    </PaperCard>
  </div>
</header>

<script is:inline>
  (function () {
    var html = document.documentElement;
    var stored = localStorage.getItem("theme");

    if (stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      html.classList.add("dark");
    }

    function toggleTheme() {
      html.classList.toggle("dark");
      localStorage.setItem("theme", html.classList.contains("dark") ? "dark" : "light");
    }

    document.addEventListener("click", function (e) {
      if (e.target.closest("#theme-toggle") || e.target.closest("#theme-toggle-mobile")) {
        toggleTheme();
      }
      if (e.target.closest("#menu-toggle")) {
        var menu = document.getElementById("mobile-menu");
        var openIcon = document.getElementById("menu-icon-open");
        var closeIcon = document.getElementById("menu-icon-close");
        menu.classList.toggle("hidden");
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      }
    });
  })();
</script>
