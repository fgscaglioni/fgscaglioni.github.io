---
import { siteLinks } from "../data/siteData";
import NavLink from "../components/NavLink.astro";
import Icon from "../components/Icon.svelte";
const currentPath = Astro.url.pathname;
---

<header data-site-header class="sticky top-0 z-50 w-full border-b border-rule bg-paper">
  <div class="mx-auto px-4 sm:px-6 py-3 flex items-center justify-between" style="max-width: calc(var(--measure) + 4rem)">
    <!-- Brand Logo (o p-1.5 com -m-1.5 amplia a área de toque sem mudar o visual) -->
    <a href="/" class="flex items-center gap-2 group shrink-0 p-1.5 -m-1.5">
      <div class="w-8 h-8 border border-rule flex items-center justify-center transition-colors duration-150 group-hover:bg-ink">
        <span class="font-display text-base font-bold text-ink group-hover:text-paper">fg</span>
      </div>
      <span class="font-display text-lg text-ink group-hover:text-ink-2 transition-colors duration-150 hidden lg:inline">
        fgscaglioni
      </span>
    </a>

    <!-- Desktop Navigation + Toggle -->
    <nav id="desktop-nav" aria-label="Navegação principal" class="hidden lg:flex items-center gap-1">
      {siteLinks.main.map((link) => (
        <NavLink
          href={link.href}
          label={link.label}
          currentPath={currentPath}
          class="px-2 py-2 text-sm font-medium tracking-wide"
        />
      ))}
      <button
        id="theme-toggle"
        type="button"
        class="ml-1 w-11 h-11 flex items-center justify-center text-ink-2 hover:text-ink hover:bg-paper-3 transition-colors duration-150"
        aria-label="Alternar tema claro/escuro"
      >
        <Icon name="moon" size={14} class="dark:hidden" />
        <Icon name="sun" size={14} class="hidden dark:block" />
      </button>
    </nav>

    <!-- Mobile: Hamburger + Toggle -->
    <div class="flex lg:hidden items-center gap-1">
      <button
        id="theme-toggle-mobile"
        type="button"
        class="w-11 h-11 flex items-center justify-center text-ink-2 hover:text-ink hover:bg-paper-3 transition-colors duration-150"
        aria-label="Alternar tema claro/escuro"
      >
        <Icon name="moon" size={14} class="dark:hidden" />
        <Icon name="sun" size={14} class="hidden dark:block" />
      </button>
      <button
        id="menu-toggle"
        type="button"
        class="w-11 h-11 flex items-center justify-center text-ink-2 hover:text-ink hover:bg-paper-3 transition-colors duration-150"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="menu-icon-open"><Icon name="bars" size={14} /></span>
        <span id="menu-icon-close" class="hidden"><Icon name="xmark" size={14} /></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <nav id="mobile-menu" aria-label="Navegação mobile" class="lg:hidden hidden">
    <div class="border-t border-rule px-4 py-3 flex flex-col gap-1">
      {siteLinks.main.map((link) => (
        <NavLink
          href={link.href}
          label={link.label}
          currentPath={currentPath}
          class="px-3 py-3 text-sm font-medium tracking-wide"
        />
      ))}
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var html = document.documentElement;
    var stored = localStorage.getItem("theme");

    if (stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      html.classList.add("dark");
    }

    function toggleTheme() {
      html.classList.toggle("dark");
      localStorage.setItem("theme", html.classList.contains("dark") ? "dark" : "light");
    }

    function closeMenu() {
      var menu = document.getElementById("mobile-menu");
      var toggle = document.getElementById("menu-toggle");
      if (!menu || !toggle) return;
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menu de navegação");
      var openIcon = document.getElementById("menu-icon-open");
      var closeIcon = document.getElementById("menu-icon-close");
      if (openIcon) openIcon.classList.remove("hidden");
      if (closeIcon) closeIcon.classList.add("hidden");
    }

    function toggleMenu() {
      var menu = document.getElementById("mobile-menu");
      var toggle = document.getElementById("menu-toggle");
      if (!menu || !toggle) return;
      var open = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Fechar menu de navegação" : "Abrir menu de navegação");
      var openIcon = document.getElementById("menu-icon-open");
      var closeIcon = document.getElementById("menu-icon-close");
      if (openIcon) openIcon.classList.toggle("hidden", open);
      if (closeIcon) closeIcon.classList.toggle("hidden", !open);
    }

    document.addEventListener("click", function (e) {
      if (e.target.closest("#theme-toggle") || e.target.closest("#theme-toggle-mobile")) {
        toggleTheme();
      }
      if (e.target.closest("#menu-toggle")) {
        toggleMenu();
        return;
      }
      // Fecha ao escolher um destino no menu
      if (e.target.closest("#mobile-menu a")) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      var menu = document.getElementById("mobile-menu");
      if (menu && !menu.classList.contains("hidden")) {
        closeMenu();
        var toggle = document.getElementById("menu-toggle");
        if (toggle) toggle.focus();
      }
    });
  })();
</script>
