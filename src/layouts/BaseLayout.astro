---
import "../styles/global.css";
import Icon from "../components/Icon.svelte";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  slug?: string;
  pubDate?: Date;
  updated?: Date;
  tags?: string[];
  isBlogPost?: boolean;
}

const {
  title = "@fgscaglioni",
  description = "Portfólio profissional de Fabrício Scaglioni — desenvolvedor de sistemas, pesquisador e doutorando em IA.",
  ogImage,
  slug,
  pubDate,
  updated,
  tags = [],
  isBlogPost = false,
} = Astro.props;

const siteUrl = "https://fgscaglioni.dev.br";

// OG Image automática: se não foi fornecida, gera via slug ou usa fallback
const finalOgImage = ogImage || (slug
  ? `${siteUrl}/og/${slug}.png`
  : "https://gravatar.com/avatar/556a14540bc4ab41d65b17218d498fd9d628698736378f62deb6e8f0849a5376");

// Schema.org JSON-LD para posts do blog
const schemaOrg = isBlogPost && slug ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: finalOgImage,
  datePublished: pubDate?.toISOString(),
  dateModified: updated?.toISOString() || pubDate?.toISOString(),
  author: {
    "@type": "Person",
    name: "Fabrício Scaglioni",
    url: siteUrl,
  },
  publisher: {
    "@type": "Person",
    name: "Fabrício Scaglioni",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${siteUrl}/blog/${slug}/`,
  },
  keywords: tags.join(", "),
} : null;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <ClientRouter fallback="animate" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6T5HCKSVKG"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-6T5HCKSVKG");
    </script>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, minimum-scale=1.0"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isBlogPost ? "article" : "website"} />
    <meta property="og:url" content={slug ? `${siteUrl}/blog/${slug}/` : siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={finalOgImage} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content={ogImage || slug ? "summary_large_image" : "summary"} />
    <meta name="twitter:url" content={slug ? `${siteUrl}/blog/${slug}/` : siteUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />

    <!-- Canonical -->
    <link rel="canonical" href={slug ? `${siteUrl}/blog/${slug}/` : siteUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Fabrício Scaglioni — Blog" href={`${siteUrl}/rss.xml`} />

    <!-- Schema.org JSON-LD -->
    {schemaOrg && <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />}

    <!-- Preconnect para recursos externos -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://gravatar.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body class="bg-[#F5F2ED] text-gray-700 font-sans antialiased min-h-screen relative overflow-x-hidden">
    <!-- Skip to content link for keyboard navigation -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:px-4 focus:py-2 focus:bg-teal-600 focus:text-white focus:rounded-lg focus:text-sm focus:font-bold focus:outline-none">
      Pular para o conteúdo
    </a>

    <!-- Header/Navbar slot -->
    <slot name="header" />

    <!-- Main Content Container (Single column layout) -->
    <main id="main-content" class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-20">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
