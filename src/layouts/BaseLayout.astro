---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { socialLinks, academicLinks } from "../data/siteData";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  slug?: string;
  pubDate?: Date;
  updated?: Date;
  tags?: string[];
  isBlogPost?: boolean;
  noindex?: boolean;
}

const {
  title = "@fgscaglioni",
  description = "Portfólio profissional de Fabrício Scaglioni, engenheiro de software, pesquisador e doutorando em IA.",
  ogImage,
  slug,
  pubDate,
  updated,
  tags = [],
  isBlogPost = false,
  noindex = false,
} = Astro.props;

const siteUrl = "https://fgscaglioni.dev.br";
const siteName = "Fabrício Scaglioni";

// Canonical sempre auto-referente. Antes, toda página sem `slug` (as 7 páginas de topo
// e as de tag) declarava a home como canônica, o que consolida essas URLs na home.
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteUrl).href;

// Card 1200x630 gerado por `scripts/generate-og.mjs` (o caminho antigo /og/<slug>.png não existia = 404).
const finalOgImage = ogImage || `${siteUrl}/og/${slug ? `${slug}.png` : "default.png"}`;

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;

const person = {
  "@type": "Person",
  "@id": personId,
  name: siteName,
  url: siteUrl,
  jobTitle: "Engenheiro de Software Sênior, Pesquisador em IA",
  affiliation: {
    "@type": "Organization",
    name: "Universidade Federal de Pelotas (UFPel)",
    url: "https://ufpel.edu.br/",
  },
  sameAs: [...socialLinks, ...academicLinks].map((l) => l.url),
};

const website = {
  "@type": "WebSite",
  "@id": websiteId,
  url: siteUrl,
  name: siteName,
  inLanguage: "pt-BR",
  publisher: { "@id": personId },
};

const blogPosting = isBlogPost && slug ? {
  "@type": "BlogPosting",
  headline: title,
  description,
  image: finalOgImage,
  inLanguage: "pt-BR",
  datePublished: pubDate?.toISOString(),
  dateModified: (updated || pubDate)?.toISOString(),
  author: { "@id": personId },
  publisher: { "@id": personId },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  isPartOf: { "@id": websiteId },
  keywords: tags.join(", "),
} : null;

const breadcrumb = isBlogPost && slug ? {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Artigos", item: `${siteUrl}/blog/` },
    { "@type": "ListItem", position: 3, name: title, item: canonical },
  ],
} : null;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [website, person, ...(blogPosting ? [blogPosting] : []), ...(breadcrumb ? [breadcrumb] : [])],
};
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <ClientRouter fallback="animate" />
    <!-- Google Analytics: só carrega sem Do Not Track (ver /privacidade) -->
    <script is:inline>
      (function () {
        if (navigator.doNotTrack === "1" || navigator.doNotTrack === "yes") return;
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=G-6T5HCKSVKG";
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", "G-6T5HCKSVKG");
      })();
    </script>
    <meta charset="UTF-8" />
    <!-- Tema antes da primeira pintura: quem salvou "escuro" não vê o site
         claro piscar. A decisão vive aqui; o botão na navbar só alterna. -->
    <script is:inline>
      try {
        var tema = localStorage.getItem("theme");
        if (tema === "dark" || (!tema && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      } catch (e) {}
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, minimum-scale=1.0"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isBlogPost ? "article" : "website"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Canonical (auto-referente em todas as páginas) -->
    <link rel="canonical" href={canonical} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Fabrício Scaglioni — Blog" href={`${siteUrl}/rss.xml`} />

    <!-- Schema.org JSON-LD: WebSite + Person (E-E-A-T) + BlogPosting/BreadcrumbList nos posts -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Fontes self-hosted (sem CSS render-blocking de terceiros) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/manrope-var-latin.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/instrument-serif-400-latin.woff2"
    />
    <!-- Mono também é preload: rótulos e datas usam a fonte acima da dobra, e
         sem preload ela entrava ~600ms depois, com o texto trocando de fonte
         à vista (sensação de página "ainda carregando"). -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/jetbrains-mono-var-latin.woff2"
    />
  </head>
  <body class="bg-paper text-ink-2 font-body antialiased min-h-screen relative overflow-x-hidden">
    <!-- Skip to content link for keyboard navigation -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:px-4 focus:py-2 focus:bg-ink focus:text-paper focus:rounded-none focus:text-sm focus:font-bold focus:outline-none">
      Pular para o conteúdo
    </a>

    <!-- Header/Navbar slot -->
    <slot name="header" />

    <!-- Main Content Container (Single column layout; medida de leitura em ch) -->
    <main id="main-content" class="mx-auto px-4 sm:px-6 pt-6 pb-20" style="max-width: calc(var(--measure) + 4rem)">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
